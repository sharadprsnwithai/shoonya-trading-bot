# ==============================================================================
# Shoonya Trading Bot Environment Configuration
# Copy this file to .env and fill in your actual credentials
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# Execution Mode: PAPER or LIVE
# - PAPER: Simulated local executions with live price fills
# - LIVE: Real broker orders routed directly to Shoonya API (/PlaceOrder)
# ------------------------------------------------------------------------------
EXECUTION_MODE=PAPER

# ------------------------------------------------------------------------------
# Shoonya (Finvasia NorenAPI) Credentials
# ------------------------------------------------------------------------------
SHOONYA_ENABLED=true
SHOONYA_USER_ID=your_shoonya_user_id
SHOONYA_PASSWORD=your_shoonya_password
SHOONYA_TOTP_SECRET=your_totp_secret_key_base32
SHOONYA_CLIENT_ID=your_client_id
SHOONYA_SECRET_KEY=your_secret_key
SHOONYA_VENDOR_CODE=NOREN_API
SHOONYA_BASE_URL=https://api.shoonya.com
SHOONYA_PUBLIC_IP=58.84.60.54

# ------------------------------------------------------------------------------
# Telegram Alerts Configuration
# ------------------------------------------------------------------------------
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ------------------------------------------------------------------------------
# Pivot SuperTrend Strategy & Scheduler Configuration
# ------------------------------------------------------------------------------
STRATEGY_SCHEDULER_ENABLED=true
STRATEGY_AUTO_EXECUTE=false
STRATEGY_LOTS=1
STRATEGY_LOT_SIZE=65
STRATEGY_LOT_QUANTITY=65
STRATEGY_MAX_DAILY_TRADES=1
STRATEGY_BUY_HEDGE=true
STRATEGY_HEDGE_DISTANCE=150
STRATEGY_OI_FILTER_ENABLED=false
STRATEGY_OI_DIFF_THRESHOLD=5000000
STRATEGY_OI_DIRECTIONAL=true
STRATEGY_ENTRY_START_TIME=09:30:00
STRATEGY_STOP_LOSS_ENABLED=true
STRATEGY_STOP_LOSS_PERCENT=30.0
STRATEGY_TARGET_PROFIT_ENABLED=true
STRATEGY_TARGET_PROFIT_PERCENT=50.0

# ------------------------------------------------------------------------------
# Triple SuperTrend + RSI Directional Options Strategy (NIFTY 50 & 29 Stocks)
# ------------------------------------------------------------------------------
TRIPLE_ST_ENABLED=true
TRIPLE_ST_MODE=OPTION_SELLING
TRIPLE_ST_TIMEFRAME=60m
TRIPLE_ST_FAST_ATR=7
TRIPLE_ST_FAST_MULT=2.0
TRIPLE_ST_MEDIUM_ATR=10
TRIPLE_ST_MEDIUM_MULT=3.0
TRIPLE_ST_SLOW_ATR=14
TRIPLE_ST_SLOW_MULT=4.0
TRIPLE_ST_RSI_PERIOD=14
TRIPLE_ST_RSI_FILTER=true
TRIPLE_ST_RSI_LOOKBACK=5
TRIPLE_ST_RSI_BULLISH_MIN=40.0
TRIPLE_ST_RSI_BEARISH_MAX=60.0
TRIPLE_ST_STOP_LOSS_ENABLED=true
TRIPLE_ST_STOP_LOSS_PERCENT=30.0
TRIPLE_ST_TARGET_PROFIT_ENABLED=true
TRIPLE_ST_TARGET_PROFIT_PERCENT=50.0
TRIPLE_ST_DTE_ROLL_THRESHOLD=10
TRIPLE_ST_INTRADAY_MODE=false
TRIPLE_ST_TELEGRAM_ALERTS=true
TRIPLE_ST_LOTS=1
TRIPLE_ST_ADX_FILTER_ENABLED=true
TRIPLE_ST_ADX_PERIOD=14
TRIPLE_ST_ADX_THRESHOLD=22.0
TRIPLE_ST_RSI_BULLISH_MAX=68.0
TRIPLE_ST_RSI_BEARISH_MIN=32.0
TRIPLE_ST_COOLDOWN_BARS=3
TRIPLE_ST_CREDIT_SPREAD_ENABLED=true
TRIPLE_ST_HEDGE_STRIKE_OFFSET=2
TRIPLE_ST_SYMBOL_BASKET=CURATED
TRIPLE_ST_REJECTION_WICK_FILTER_ENABLED=true
TRIPLE_ST_REJECTION_WICK_THRESHOLD=0.60
TRIPLE_ST_ATR_FILTER_ENABLED=true
TRIPLE_ST_MIN_ATR_RATIO=0.60
TRIPLE_ST_MAX_ATR_RATIO=2.50
TRIPLE_ST_EMA_FILTER_ENABLED=true
TRIPLE_ST_EMA_PERIOD=50
TRIPLE_ST_VOLUME_FILTER_ENABLED=false
TRIPLE_ST_VOLUME_MULTIPLIER=1.10

# ------------------------------------------------------------------------------
# Monthly Basket Rebalance Configuration (1st of month 09:00 IST)
# ------------------------------------------------------------------------------
REBALANCE_ENABLED=true
REBALANCE_CRON=0 0 9 1 * ?
REBALANCE_LOOKBACK_DAYS=30

# ------------------------------------------------------------------------------
# Lowest Volume Reversal Strategy (LVR Intraday Options Buying)
# ------------------------------------------------------------------------------
LVR_ENABLED=true
LVR_SCHEDULER_ENABLED=true
LVR_SCANNER_CRON=10 25 9 ? * MON-FRI
LVR_CRON=10 */5 9-15 ? * MON-FRI
LVR_PAPER_CAPITAL=1000000.0
LVR_RISK_PER_TRADE=1.0
LVR_MAX_CONCURRENT_TRADES=5
LVR_MIN_PCT_CHANGE=1.0
LVR_TOP_N_STOCKS=10
LVR_TIMEOUT_CANDLES=6
LVR_TELEGRAM_ALERTS=true
LVR_OPTION_BUYING=true
LVR_LIVE_BREACH_CHECK=true
LVR_LOTS=4

# ------------------------------------------------------------------------------
# NIFTY 5m vs 15m RSI Crossover Options Strategy
# ------------------------------------------------------------------------------
RSI_CROSSOVER_ENABLED=true
RSI_CROSSOVER_MODE=OPTION_SELLING
RSI_CROSSOVER_SCHEDULER_ENABLED=true
RSI_CROSSOVER_CRON=10 */5 9-15 ? * MON-FRI
RSI_CROSSOVER_SQUARE_OFF_CRON=10 5 15 ? * MON-FRI
RSI_CROSSOVER_AUTO_EXECUTE=false
RSI_CROSSOVER_LOTS=1
RSI_CROSSOVER_LOT_SIZE=65
RSI_CROSSOVER_RSI_PERIOD=14
RSI_CROSSOVER_ADX_FILTER_ENABLED=true
RSI_CROSSOVER_ADX_THRESHOLD=20.0
RSI_CROSSOVER_STOP_LOSS_PERCENT=2.0
RSI_CROSSOVER_TARGET_PROFIT_PERCENT=50.0
RSI_CROSSOVER_HEDGE_ENABLED=true
RSI_CROSSOVER_HEDGE_OTM_PERCENT=2.0
RSI_CROSSOVER_MAX_TRADES_PER_DAY=1
RSI_CROSSOVER_TELEGRAM_ALERTS=true

