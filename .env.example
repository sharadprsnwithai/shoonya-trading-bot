# ==============================================================================
# Shoonya Trading Bot Environment Configuration
# Copy this file to .env and fill in your actual credentials
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# Execution Mode: PAPER or LIVE
# - PAPER: Simulated local executions with live price fills
# - LIVE: Real broker orders routed directly to Shoonya API (/PlaceOrder)
# ------------------------------------------------------------------------------
EXECUTION_MODE=PAPER

# ------------------------------------------------------------------------------
# Shoonya (Finvasia NorenAPI) Credentials
# ------------------------------------------------------------------------------
SHOONYA_ENABLED=true
SHOONYA_USER_ID=your_shoonya_user_id
SHOONYA_PASSWORD=your_shoonya_password
SHOONYA_TOTP_SECRET=your_totp_secret_key_base32
SHOONYA_CLIENT_ID=your_client_id
SHOONYA_SECRET_KEY=your_secret_key
SHOONYA_VENDOR_CODE=NOREN_API
SHOONYA_BASE_URL=https://api.shoonya.com
SHOONYA_PUBLIC_IP=58.84.60.54

# ------------------------------------------------------------------------------
# Telegram Alerts Configuration
# ------------------------------------------------------------------------------
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ------------------------------------------------------------------------------
# Lowest Volume Reversal Strategy (LVR Intraday Options Buying)
# ------------------------------------------------------------------------------
LVR_ENABLED=true
LVR_SCHEDULER_ENABLED=true
LVR_SCANNER_CRON=10 25 9 ? * MON-FRI
LVR_CRON=10 */5 9-11 ? * MON-FRI
LVR_PAPER_CAPITAL=1000000.0
LVR_RISK_PER_TRADE=1.0
LVR_MAX_CONCURRENT_TRADES=5
LVR_MIN_PCT_CHANGE=1.0
LVR_TOP_N_STOCKS=10
LVR_TIMEOUT_CANDLES=6
LVR_TELEGRAM_ALERTS=true
LVR_TELEGRAM_ARMED_ALERTS=false
LVR_OPTION_BUYING=true
LVR_LIVE_BREACH_CHECK=true
LVR_LOTS=4

# ------------------------------------------------------------------------------
# NIFTY 5m vs 15m RSI Crossover Options Strategy
# ------------------------------------------------------------------------------
RSI_CROSSOVER_ENABLED=true
RSI_CROSSOVER_MODE=OPTION_SELLING
RSI_CROSSOVER_SCHEDULER_ENABLED=true
RSI_CROSSOVER_CRON=10 */5 9-15 ? * MON-FRI
RSI_CROSSOVER_SQUARE_OFF_CRON=10 5 15 ? * MON-FRI
RSI_CROSSOVER_AUTO_EXECUTE=false
RSI_CROSSOVER_LOTS=1
RSI_CROSSOVER_LOT_SIZE=65
RSI_CROSSOVER_RSI_PERIOD=14
RSI_CROSSOVER_ADX_FILTER_ENABLED=true
RSI_CROSSOVER_ADX_THRESHOLD=20.0
RSI_CROSSOVER_STOP_LOSS_PERCENT=2.0
RSI_CROSSOVER_TARGET_PROFIT_PERCENT=50.0
RSI_CROSSOVER_HEDGE_ENABLED=true
RSI_CROSSOVER_HEDGE_OTM_PERCENT=2.0
RSI_CROSSOVER_MAX_TRADES_PER_DAY=1
RSI_CROSSOVER_TELEGRAM_ALERTS=true

# ------------------------------------------------------------------------------
# 19-Period Daily WMA Positional Hedged Option Selling Strategy
# ------------------------------------------------------------------------------
DAILY_WMA_ENABLED=true
DAILY_WMA_SCHEDULER_ENABLED=true
DAILY_WMA_MODE=PAPER
DAILY_WMA_EVAL_CRON=10 30 9 ? * MON-FRI
DAILY_WMA_SL_CRON=10 */5 9-15 ? * MON-FRI
DAILY_WMA_SQUARE_OFF_CRON=10 15 15 ? * MON-FRI
DAILY_WMA_SYMBOL=10576
DAILY_WMA_PERIOD=19
DAILY_WMA_TARGET_DELTA=0.22
DAILY_WMA_MAX_ENTRY_PREMIUM=105.0
DAILY_WMA_EXPIRY_SWITCH_DAY=15
DAILY_WMA_HEDGE_OTM_PERCENT=0.02
DAILY_WMA_STOP_LOSS_PERCENT=1.0
DAILY_WMA_ALLOW_REENTRY=true
DAILY_WMA_LOTS=1
DAILY_WMA_LOT_SIZE=65
DAILY_WMA_STATE_FILE=data/wma_positional_state.json


