# ==============================================================================
# Shoonya Trading Bot Environment Configuration
# Copy this file to .env and fill in your actual credentials
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# Execution Mode: PAPER or LIVE
# - PAPER: Simulated local executions with live price fills
# - LIVE: Real broker orders routed directly to Shoonya API (/PlaceOrder)
# ------------------------------------------------------------------------------
EXECUTION_MODE=PAPER

# ------------------------------------------------------------------------------
# Shoonya (Finvasia NorenAPI) Credentials
# ------------------------------------------------------------------------------
SHOONYA_ENABLED=true
SHOONYA_USER_ID=your_shoonya_user_id
SHOONYA_PASSWORD=your_shoonya_password
SHOONYA_TOTP_SECRET=your_totp_secret_key_base32
SHOONYA_CLIENT_ID=your_client_id
SHOONYA_SECRET_KEY=your_secret_key
SHOONYA_VENDOR_CODE=NOREN_API
SHOONYA_BASE_URL=https://api.shoonya.com
SHOONYA_PUBLIC_IP=58.84.60.54

# ------------------------------------------------------------------------------
# Telegram Alerts Configuration
# ------------------------------------------------------------------------------
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ------------------------------------------------------------------------------
# Pivot SuperTrend Strategy & Scheduler Configuration
# ------------------------------------------------------------------------------
STRATEGY_SCHEDULER_ENABLED=true
STRATEGY_AUTO_EXECUTE=false
STRATEGY_LOTS=1
STRATEGY_LOT_SIZE=65
STRATEGY_LOT_QUANTITY=65
STRATEGY_MAX_DAILY_TRADES=1
STRATEGY_BUY_HEDGE=true
STRATEGY_HEDGE_DISTANCE=150
STRATEGY_OI_FILTER_ENABLED=false
STRATEGY_OI_DIFF_THRESHOLD=5000000
STRATEGY_OI_DIRECTIONAL=true
STRATEGY_ENTRY_START_TIME=09:30:00
STRATEGY_STOP_LOSS_ENABLED=true
STRATEGY_STOP_LOSS_PERCENT=30.0
STRATEGY_TARGET_PROFIT_ENABLED=true
STRATEGY_TARGET_PROFIT_PERCENT=50.0
