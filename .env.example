# ==============================================================================
# Shoonya Trading Bot Environment Configuration
# Copy this file to .env and fill in your actual credentials
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# Execution Mode: PAPER or LIVE
# - PAPER: Simulated local executions with live price fills
# - LIVE: Real broker orders routed directly to Shoonya API (/PlaceOrder)
# ------------------------------------------------------------------------------
EXECUTION_MODE=PAPER

# ------------------------------------------------------------------------------
# Shoonya (Finvasia NorenAPI) Credentials
# ------------------------------------------------------------------------------
SHOONYA_ENABLED=true
SHOONYA_USER_ID=your_shoonya_user_id
SHOONYA_PASSWORD=your_shoonya_password
SHOONYA_TOTP_SECRET=your_totp_secret_key_base32
SHOONYA_CLIENT_ID=your_client_id
SHOONYA_SECRET_KEY=your_secret_key
SHOONYA_VENDOR_CODE=NOREN_API
SHOONYA_BASE_URL=https://api.shoonya.com
SHOONYA_PUBLIC_IP=58.84.60.54

# ------------------------------------------------------------------------------
# Zerodha Kite Connect Credentials
# ------------------------------------------------------------------------------
KITE_ENABLED=true
KITE_API_KEY=xz6f5qndx8fl6jc5
KITE_API_SECRET=w2hl2ppyv3k0bqem4i31tq8bmwi9npsx
KITE_USER_ID=your_zerodha_user_id
KITE_PASSWORD=your_zerodha_password
KITE_TOTP_KEY=your_zerodha_totp_secret_key
KITE_REDIRECT_URI=https://untaxed-substance-reputably.ngrok-free.dev/api/kite/auth/callback
KITE_SESSION_FILE=data/kite_session.json
ZERODHA_EXECUTION_MODE=PAPER
ZERODHA_BOLLINGER_HA_MODE=PAPER
ZERODHA_LVR_MODE=PAPER
ZERODHA_CAR_MODE=PAPER
ZERODHA_CONDOR_MODE=PAPER
SHOONYA_CONDOR_MODE=PAPER
SHOONYA_DRIFT_VWAP_MODE=PAPER
ZERODHA_DRIFT_VWAP_MODE=PAPER



# ------------------------------------------------------------------------------
# Telegram Alerts Configuration
# ------------------------------------------------------------------------------
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ------------------------------------------------------------------------------
# Logging Level (INFO for production, DEBUG for deep troubleshooting)
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO

LVR_ENABLED=true
LVR_SCHEDULER_ENABLED=true
# 5-minute cycle cron — must match trading-bot.strategy.lowest-volume.cron (M11: was 9-11 here
# vs 9-15 actual, silently overriding the schedule for anyone who copied this file)
LVR_CRON=20 */5 9-15 ? * MON-FRI
LVR_PAPER_CAPITAL=1000000.0
LVR_RISK_PER_TRADE=1.0
LVR_MAX_CONCURRENT_TRADES=5
LVR_TIMEOUT_CANDLES=6
LVR_TELEGRAM_ALERTS=true
LVR_TELEGRAM_ARMED_ALERTS=false
LVR_VWAP_CONFIRMATION=true
LVR_OPENING_15M_RANGE_FILTER_ENABLED=true
LVR_TARGET_RR=2.5
LVR_MAX_DAILY_LOSSES=2
LVR_VANDE_BHARAT_ENABLED=false
LVR_SECTOR_MOMENTUM_FILTER=true
# 30s live breach check (lvr_30sec_live_check_spec §3); false = 5-min-cycle-only behavior
LVR_LIVE_BREACH_CHECK=true
# Entry gate / scanner knobs actually read by the app (M11: dead vars removed)
LVR_SCANNER_MODE=HYBRID
LVR_OI_SPURTS_TOP_N=5
LVR_PDH_PDL_FILTER_ENABLED=true
LVR_PCR_FILTER_ENABLED=true
LVR_PCR_MIN_LONG=0.85
LVR_PCR_MAX_SHORT=1.15
LVR_OPTION_SR_FILTER_ENABLED=true
LVR_OPTION_SR_BUFFER_PCT=0.0
LVR_SCANNER_FALLBACK_CUTOFF=10:00
LVR_ENTRY_CUTOFF=11:30
LVR_INSTRUMENT_TYPE=FUTURES
LVR_ORDER_TYPE=LMT
# Exit authority is 1:2 R:R — *_1_4 modes were removed (they computed 1:2 anyway)
LVR_EXIT_MODE=PARTIAL_1_2_TRAIL_10EMA_COST_EOD_1500
LVR_LOTS=2
LVR_DYNAMIC_POSITION_SIZING=false
LVR_MAX_ATTEMPTS_PER_SYMBOL=2
LVR_MIN_BREADTH_PCT=56.0
LVR_MIN_SL_PCT=0.35
LVR_MAX_DAILY_LOSS=15000.0
LVR_MAX_SLIPPAGE_PCT=0.12

# ------------------------------------------------------------------------------
# LVR state persistence (M10): daily JSON snapshot of positions/P&L
# ------------------------------------------------------------------------------
LVR_STATE_FILE=./data/lvr-state.json
LVR_STATE_PERSISTENCE_ENABLED=true

# ------------------------------------------------------------------------------
# API auth (H6): bearer token for mutating /api/** endpoints (POST/PUT/DELETE).
# Empty = unauthenticated (startup WARN). Send as "Authorization: Bearer <token>"
# or "X-Api-Token: <token>".
# ------------------------------------------------------------------------------
API_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# Cumulative Average Reversal (CAR) Weekly GTT Strategy Parameters
# ------------------------------------------------------------------------------
CAR_ENABLED=true
CAR_TOTAL_CAPITAL=1000000.0
CAR_NUM_PARTS=40
CAR_PROFIT_TARGET_PCT=6.28
CAR_ACCUMULATION_ONLY_SYMBOLS=SGB,BEES,CASE






